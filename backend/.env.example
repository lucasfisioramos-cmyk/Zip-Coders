# Endpoint do RDS (Postgres). O Prisma usa essa mesma URL pra tudo.
# Se o RDS exigir SSL, adicione ?sslmode=require no final.
# Ex: postgres://usuario:senha@seu-rds.xxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/altave?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/altave

# Segredo usado para assinar o token de login. Troque por um valor aleatório forte.
JWT_SECRET=troque-este-segredo-em-producao

PORT=3001

# Banco local do compose.local.yaml. Em homologação, configure a instância exclusiva.
DATABASE_URL=postgresql://zip_local:zip_local@127.0.0.1:55432/zip_coders_local?schema=public
# Gere um segredo por ambiente com: openssl rand -hex 32
JWT_SECRET=
PORT=3001

# Opcional. Com SMTP_HOST vazio, os e-mails são simulados no console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Altave OS <no-reply@altave.com.br>"

// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS (Listas de valores fixos)
// ==========================================

enum PerfilUsuario {
  ADMIN
  GESTOR
  EXECUTOR
  USUARIO
}

enum StatusOS {
  RASCUNHO      // "requisição" - OS ainda sendo preenchida, não é uma OS oficial ainda
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

enum PrioridadeOS {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

// ==========================================
// MODELOS (Tabelas)
// ==========================================

model Usuario {
  id        String        @id @default(uuid())
  nome      String        @db.VarChar(100)
  email     String        @unique @db.VarChar(100)
  senhaHash String        @map("senha_hash") @db.VarChar(255)
  perfil    PerfilUsuario
  ativo     Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")

  ordensSolicitadas  OrdemServico[] @relation("OS_Solicitante")
  ordensResponsaveis OrdemServico[] @relation("OS_Responsavel")
  historicos         Historico[]
  logsAuditoria      LogAuditoria[]

  @@index([perfil])
  @@index([ativo])
  @@map("usuarios")
}

model OrdemServico {
  id            String       @id @default(uuid())
  codigo        String       @unique @db.VarChar(20)
  titulo        String       @db.VarChar(150)
  descricao     String       @db.Text
  status        StatusOS     @default(RASCUNHO)

  // Opcional: enquanto a OS está em RASCUNHO (requisição), a prioridade
  // pode ainda não ter sido definida. Vira obrigatória na prática (via
  // validação na aplicação) no momento em que status muda para ABERTA.
  prioridade    PrioridadeOS?

  solicitanteId String       @map("solicitante_id")
  solicitante   Usuario      @relation("OS_Solicitante", fields: [solicitanteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  responsavelId String?      @map("responsavel_id")
  responsavel   Usuario?     @relation("OS_Responsavel", fields: [responsavelId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // Opcional: só é preenchida no momento em que a OS de fato "abre"
  // (transição RASCUNHO -> ABERTA), não na criação do registro.
  dataAbertura  DateTime?    @map("data_abertura")
  dataConclusao DateTime?    @map("data_conclusao")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  historicos    Historico[]

  @@index([status])
  @@index([prioridade])
  @@index([solicitanteId])
  @@index([responsavelId])
  @@index([dataAbertura])
  @@map("ordens_servico")
}

model Historico {
  id             String   @id @default(uuid())

  ordemId        String   @map("ordem_id")
  ordem          OrdemServico @relation(fields: [ordemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  usuarioId      String   @map("usuario_id")
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Antes eram 3 campos genéricos (campoAlterado/valorAntigo/valorNovo).
  // Agora só registramos a transição de status, tipada pelo próprio enum.
  statusAnterior StatusOS? @map("status_anterior") // null no primeiro registro (criação da requisição)
  statusNovo     StatusOS  @map("status_novo")

  createdAt      DateTime @default(now()) @map("created_at")

  @@index([ordemId])
  @@index([usuarioId])
  @@index([createdAt])
  @@map("historico")
}

model LogAuditoria {
  id         String   @id @default(uuid())

  usuarioId  String?  @map("usuario_id")
  usuario    Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  acao       String   @db.VarChar(50)
  detalhes   Json?
  ipOrigem   String?  @map("ip_origem") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([usuarioId])
  @@index([acao])
  @@index([createdAt])
  @@map("logs_auditoria")
}
